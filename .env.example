# Emplacement persistant des données runtime. Sous Windows, la valeur par défaut est
# %LOCALAPPDATA%\CADUCEUS ; sous Linux/macOS ~/.caduceus.
# CADUCEUS_HOME=C:\Users\<vous>\AppData\Local\CADUCEUS

# Référentiel métier livré avec les sources.
CADUCEUS_CAMCIS_PATH=data/reference/Code_SH_CAMCIS.xlsx
CADUCEUS_VALIDATED_CASES_PATH=data/validated_cases

# Les chemins ci-dessous sont optionnels. Sans surcharge, ils sont placés sous CADUCEUS_HOME.
# CADUCEUS_AUDIT_DB=...
# CADUCEUS_METRICS_DB=...
# CADUCEUS_QDRANT_PATH=...
# CADUCEUS_INDEX_MANIFEST=...
# CADUCEUS_REFERENCE_STATE=...
# CADUCEUS_BENCHMARK_CACHE=...

# Qdrant local embarqué : aucun Docker requis.
CADUCEUS_QDRANT_COLLECTION=camcis_tariff_v2
CADUCEUS_ENABLE_SEMANTIC=1
CADUCEUS_AUTO_SYNC_INDEX=1
CADUCEUS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CADUCEUS_EMBEDDING_BATCH_SIZE=128
CADUCEUS_KEEP_OLD_INDEXES=0

CADUCEUS_AUTO_ACCEPT_SCORE=0.82
CADUCEUS_MIN_MARGIN=0.08

# Modèles comparés uniquement lors d'un benchmark explicite.
CADUCEUS_BENCHMARK_MODELS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2,intfloat/multilingual-e5-small

# OCR optionnel pour images/PDF scannés. Laissez vide si tesseract.exe est dans le PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Sprint 6 — arbitrage IA contrôlé. Aucun appel n'est nécessaire au démarrage.
# L'IA reçoit uniquement une description métier minimale + une liste fermée de candidats CAMCIS.
CADUCEUS_ENABLE_LLM_ARBITRATION=1
CADUCEUS_LLM_PROVIDER=AUTO
CADUCEUS_LLM_TIMEOUT_SECONDS=45
CADUCEUS_MAX_LLM_CALLS_PER_DOSSIER=25
CADUCEUS_LLM_MIN_CONFIDENCE=0.70
CADUCEUS_LLM_MIN_RETRIEVAL_SCORE=0.35

# NVIDIA API Catalog — fournisseur prioritaire pour le PoC.
# Le même secret est utilisé pour l'arbitrage texte et le renfort vision.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_VISION_MODEL=deepseek-ai/deepseek-v4.1-flash

# Renfort multimodal : l'OCR local reste prioritaire et aucun appel cloud n'est
# effectué si la capture structurée est déjà suffisamment fiable.
CADUCEUS_ENABLE_AI_VISION=1
CADUCEUS_AI_VISION_PROVIDER=NVIDIA
CADUCEUS_AI_VISION_CAPTURE_THRESHOLD=0.82
CADUCEUS_AI_VISION_TIMEOUT_SECONDS=60

# OpenAI — laissez vide pour désactiver.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
