# Ne jamais committer un vrai secrets.toml.
# Copiez uniquement les valeurs nécessaires dans Streamlit Cloud > App settings > Secrets.

CADUCEUS_ENABLE_LLM_ARBITRATION = "1"
CADUCEUS_LLM_PROVIDER = "AUTO"
CADUCEUS_MAX_LLM_CALLS_PER_DOSSIER = "25"

# Optionnel — NVIDIA/Kimi
NVIDIA_API_KEY = ""
NVIDIA_BASE_URL = "https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL = "moonshotai/kimi-k3"

# Optionnel — OpenAI
OPENAI_API_KEY = ""
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-5.6-luna"

# La recherche sémantique locale est activée par défaut.
# Si Community Cloud atteint ses limites RAM lors du premier déploiement,
# passez temporairement cette valeur à "0" pour démarrer en mode lexical+mémoire.
CADUCEUS_ENABLE_SEMANTIC = "1"
CADUCEUS_AUTO_SYNC_INDEX = "1"
